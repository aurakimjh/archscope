    {
      "client": "curl",
      "transport": "http/1.1",
      "captureMode": "proxy_mitm",
      "fidelity": "decoded_wire",
      "coverage": "confirmed"
    },
    {
      "client": "jvm",
      "transport": "http/1.1",
      "captureMode": "proxy_mitm",
      "fidelity": "decoded_wire",
      "coverage": "confirmed"
    },
    {
      "client": "electron",
      "transport": "http/1.1",
      "captureMode": "proxy_mitm",
      "fidelity": "decoded_wire",
      "coverage": "confirmed"
