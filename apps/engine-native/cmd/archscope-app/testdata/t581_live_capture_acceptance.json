  "unsupportedTier": [
    {
      "scenario": "h2-only",
      "fidelity": "unsupported",
      "semanticCapture": false
    },
    {
      "scenario": "quic",
      "fidelity": "unsupported",
      "semanticCapture": false
    },
    {
      "scenario": "certificate-pinning",
      "fidelity": "unsupported",
      "semanticCapture": false
    }
  ],
  "security": {
    "retainUnattributedMetadataDefault": false,
    "bodyStorage": "omitted",
    "caRemovedOnStop": true
  },
  "renderer": {
    "rowCap": 500,
    "resyncOnEventSkip": true,
    "restoreCurrentSessionOnPageReentry": true,
    "finalizedSessionUsesAnalysisResult": true
  },
  "acceptanceEvidence": {
    "schemaVersion": 1,
    "maxRows": 2000,
    "requiresTerminalSession": true,
    "productReadback": true,
    "failsOnMissingClient": true,
    "transports": [
      "http",
      "https"
    ]
  },
  "store": {
    "stableSnapshotCursor": true,
    "sessionBoundCursor": true,
    "maxFetchLimit": 2000,
    "filters": [
      "host",
      "method",
      "statusCode",
      "processId",
      "errorsOnly"
    ]
  }
}
