{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "버전 고정 보고서 시각 자료 명세",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "template",
    "template_version",
    "renderer",
    "font_sha256",
    "redaction_profile",
    "view_sha256",
    "sources",
    "query",
    "presentation"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "template": {
      "enum": [
        "provider_table",
        "profile_top",
        "profile_flamegraph",
        "profile_diff"
      ]
    },
    "template_version": {
      "type": "string"
    },
    "renderer": {
      "type": "string"
    },
    "font_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "redaction_profile": {
      "type": "string"
    },
    "view_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "sha256",
          "type",
          "payload_version"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "type": {
            "type": "string"
          },
          "payload_version": {
            "type": "string"
          }
        }
      }
    },
    "query": {
      "type": "object",
      "required": [
        "kind",
        "offset",
        "limit"
      ]
    },
    "presentation": {
      "type": "object",
      "required": [
        "width",
        "height",
        "font_size",
        "rows_per_page",
        "transparent",
        "title",
        "annotation"
      ],
      "properties": {
        "width": {
          "enum": [
            1600,
            2400,
            3200
          ]
        },
        "height": {
          "type": "integer",
          "minimum": 800,
          "maximum": 2400
        },
        "font_size": {
          "type": "integer",
          "minimum": 20,
          "maximum": 48
        },
        "rows_per_page": {
          "type": "integer",
          "minimum": 5,
          "maximum": 25
        },
        "transparent": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "annotation": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "parent": {
      "type": "string",
      "maxLength": 96
    }
  },
  "$comment": "파일별 hash, 선택·분모·품질·글꼴 binding과 총 면적/용량은 compiled validator에서도 검증한다. 과거 이미지와 명시적 새 리비전을 구분한다."
}
