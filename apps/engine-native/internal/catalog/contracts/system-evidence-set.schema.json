{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "시스템 성능 근거 모델",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "format",
    "source_sha256",
    "capture",
    "records"
  ],
  "properties": {
    "version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "format": {
      "enum": [
        "perf-script",
        "events-jsonl",
        "bpftrace-jsonl"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "tool",
        "tool_version",
        "clock",
        "boot_id",
        "pid_namespace",
        "lost",
        "unwind_failures",
        "kernel_symbols",
        "frequency_hz",
        "entities",
        "events",
        "histograms"
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "line",
          "kind"
        ]
      }
    },
    "frames": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object"
      }
    },
    "stacks": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "array",
        "maxItems": 1024,
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$comment": "정확한 문자열 수치·입력별 선언·entity 수명·bucket 순서·출처 ID와 전체 용량은 compiled validator가 추가 검증한다. 집계 histogram을 이벤트로 만들지 않는다. 1.1.0은 frame/stack 표와 record.stack_id 정수 참조로 중복을 제거한다. 1.0.0 inline stack reader는 유지한다. 참조·공유 풀 정합성은 compiled validator가 검사한다.",
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "frames",
          "stacks"
        ],
        "properties": {
          "records": {
            "items": {
              "not": {
                "required": [
                  "stack"
                ]
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "frames"
              ]
            },
            {
              "required": [
                "stacks"
              ]
            }
          ]
        }
      }
    }
  ]
}
