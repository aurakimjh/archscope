{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "장치·추론 서빙 의미 연결 모델",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metrics",
    "entities",
    "links",
    "contexts",
    "signals",
    "event_sources",
    "events",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "metrics": {
      "type": "object"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "host_id",
          "boot_id"
        ]
      }
    },
    "links": {
      "type": "array",
      "maxItems": 4096
    },
    "contexts": {
      "type": "array",
      "maxItems": 1024
    },
    "signals": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "required": [
          "id",
          "series_id",
          "semantic",
          "entity_id",
          "boundary",
          "population",
          "statistical_form",
          "conversion"
        ],
        "properties": {
          "declared_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "kind",
              "temporality",
              "monotonic"
            ],
            "properties": {
              "unit": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "gauge",
                  "sum"
                ]
              },
              "temporality": {
                "enum": [
                  "unspecified",
                  "cumulative"
                ]
              },
              "monotonic": {
                "type": "boolean"
              },
              "start_ns": {
                "type": "string"
              },
              "expected_step_ns": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "event_sources": {
      "type": "array",
      "maxItems": 128
    },
    "events": {
      "type": "array",
      "maxItems": 20000
    },
    "quality": {
      "type": "array",
      "maxItems": 100000
    }
  },
  "$comment": "미터법·단위·통계 형식·참조·명시적 identity·OOM 구분·token 경계·원본 ID 및 32 MiB 모델 한도는 compiled validator가 추가 검증한다. 원본 metrics는 한 번만 저장한다."
}
