{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:diagnostics:metric-mapping:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "aliases",
    "producer",
    "producer_versions",
    "producer_path",
    "version_path",
    "match",
    "name_paths",
    "value_paths",
    "scale",
    "unit",
    "measurement_kind"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "maxLength": 96
    },
    "aliases": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producer_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "producer_path": {
      "type": "string",
      "maxLength": 256
    },
    "version_path": {
      "type": "string",
      "maxLength": 256
    },
    "match": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "string",
        "maxLength": 128
      }
    },
    "name_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "value_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "scale": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,128})?$",
      "maxLength": 256
    },
    "unit": {
      "enum": [
        "seconds",
        "milliseconds",
        "microseconds",
        "nanoseconds",
        "bytes",
        "count",
        "ratio",
        "percent"
      ]
    },
    "measurement_kind": {
      "enum": [
        "gauge",
        "counter"
      ]
    }
  }
}
