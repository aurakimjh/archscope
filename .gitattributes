docs/review/evidence/*.json text eol=lf
docs/review/evidence/*.sha256 text eol=lf
# Embedded contracts are verified against byte-level SHA-256 manifests.
apps/engine-native/internal/catalog/contracts/* text eol=lf
apps/engine-native/internal/cases/contracts/* text eol=lf
# Signed/hashed resources and upstream notices must keep their exact bytes.
apps/engine-native/internal/packs/assets/* -text
apps/engine-native/internal/distribution/assets/** -text whitespace=-blank-at-eol
docs/en/OFFLINE_PACKS.md text eol=lf
docs/ko/OFFLINE_PACKS.md text eol=lf
# The shipped notice inventory pins these source lock bytes across platforms.
apps/engine-native/go.sum text eol=lf
apps/engine-native/cmd/archscope-app/frontend/package-lock.json text eol=lf

# Visual resources retain the embedded schema/upstream font license bytes.
apps/engine-native/internal/visuals/assets/* -text whitespace=-blank-at-eol
# Clipboard TSV evidence intentionally uses CRLF and exact transport bytes.
docs/review/evidence/2026-11-12-t636/*.tsv -text whitespace=cr-at-eol

# Pinned source fixtures must keep their manifest bytes across platforms.
apps/engine-native/internal/parsers/systemtrace/testdata/* text eol=lf
apps/engine-native/internal/parsers/systemtrace/testdata/*.data -text
apps/engine-native/internal/catalog/contracts/*.data -text
# Preserve exact native perf export bytes, including trailing separator spaces.
apps/engine-native/internal/parsers/systemtrace/testdata/perf-script.txt whitespace=-blank-at-eol,-blank-at-eof
apps/engine-native/internal/catalog/contracts/system-evidence-perf-script.txt whitespace=-blank-at-eol,-blank-at-eof

# Synthetic device/serving contracts use manifest-pinned LF bytes.
apps/engine-native/internal/parsers/inference/testdata/* text eol=lf
apps/engine-native/internal/analyzers/systemtrace/testdata/*.json text eol=lf
